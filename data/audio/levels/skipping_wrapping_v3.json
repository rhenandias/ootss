          "transcripts": {
            "en": [
              "Borraidus, what do you make of this? I feel strange about this one.",
              "Borraidus? Are you there?",
              "Okay then. This is the situation."
            ],
            "de": [
              "Borraidus, was hältst du davon? Bei diesem hier habe ich ein seltsames Gefühl.",
              "Borraidus? Bist du da?",
              "Also gut. So sieht die Lage aus."
            ],
            "es": [
              "Borraidus, ¿qué te parece esto? Me da mala espina esta vez.",
              "¿Borraidus? ¿Estás ahí?",
              "Vale, bien. Esta es la situación."
            ],
            "fr": [
              "Borraidus, qu'est-ce que tu penses de tout ça ? Ça me met mal à l'aise.",
              "Borraidus ? Tu es là ?",
              "Bon. Voilà donc où j'en suis."
            ],
            "it": [
              "Borraidus, che ne pensi? Mi sento strana al riguardo.",
              "Borraidus? Ci sei?",
              "Va bene, allora. Questa è la situazione."
            ],
            "ja": [
              "ボライダス、どう思う？ なんだか妙な感じがする。",
              "ボライダス？いる？",
              "一人になったか。"
            ],
            "ko": [
              "보라이두스, 이거 어떻게 생각해? 좀 이상하게 느껴지는데.",
              "보라이두스? 거기 있어?",
              "좋아. 상황은 바로 이런 거야."
            ],
            "pt-br": [
              "Borraidus, o que você acha disso? Tenho uma sensação estranha sobre isso.",
              "Borraidus? Você está aí?",
              "Certo, então. Esta é a situação."
            ],
            "ru": [
              "Боррайдус, что ты об этом думаешь? У меня по этому поводу странное чувство.",
              "Боррайдус? Ты здесь?",
              "Ладно. Вот какова обстановка."
            ],
            "s-cn": [
              "博莱达斯，你怎么看？这一处总让我觉得不对劲。",
              "博莱达斯？你在吗？",
              "好吧，现在就是这么个情况。"
            ],
            "t-cn": [
              "博萊達斯，你怎麼看？這一處總讓我覺得不對勁。",
              "博萊達斯？你在嗎？",
              "好吧，現在就是這麼個情況。"
            ]
