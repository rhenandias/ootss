          "transcripts": {
            "en": [
              "The mirrors feel ... strangely stilling of the mind."
            ],
            "de": [
              "Die Spiegel geben ... dem Geist ein seltsames beruhigendes Gefühl."
            ],
            "es": [
              "Los espejos resultan... extrañamente tranquilizadores para la mente."
            ],
            "fr": [
              "Les miroirs procurent une... étrange sensation d'apaisement."
            ],
            "it": [
              "Gli specchi sembrano... stranamente capaci di placare la mente."
            ],
            "ja": [
              "どういうわけか… 雑念が消える。"
            ],
            "ko": [
              "거울은... 묘하게 마음을 가라앉히는 느낌이야."
            ],
            "pt-br": [
              "Os espelhos dão uma sensação... estranhamente apaziguadora da mente."
            ],
            "ru": [
              "От зеркал становится... странно тихо в голове."
            ],
            "s-cn": [
