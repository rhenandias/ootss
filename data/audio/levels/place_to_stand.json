          "transcripts": {
            "en": [
              "I haven't been this alone in a long time.",
              "Peaceful, but sad."
            ],
            "de": [
              "Ich bin schon lange nicht mehr so allein gewesen.",
              "Es fühlt sich friedlich an, aber auch traurig."
            ],
            "es": [
              "No me he sentido así de sola en mucho tiempo.",
              "La sensación es de paz, pero también de tristeza."
            ],
            "fr": [
              "Je ne m'étais pas sentie aussi seule depuis longtemps.",
              "C'est paisible, mais triste."
            ],
            "it": [
              "Non mi sentivo così sola da molto tempo.",
              "Sembra tranquillo, ma triste."
            ],
            "ja": [
              "こんなに一人きりなのは 久しぶりだ。",
              "落ち着くけど 寂しいね。"
            ],
            "ko": [
