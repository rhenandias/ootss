          "transcripts": {
            "en": [
              "Still don't understand how I got out of there --",
              "some kind of intervention from afar --",
              "First, I'll find the others."
            ],
            "de": [
              "Ich verstehe noch immer nicht, wie ich da herausgekommen bin –",
              "Irgendeine Art von Eingreifen aus der Ferne –",
              "Zuerst finde ich die anderen."
            ],
            "es": [
              "Aún no entiendo cómo salí de allí...",
              "Fue algún tipo de intervención desde la distancia...",
              "Primero, encontraré a los demás."
            ],
            "fr": [
              "Je ne comprends toujours pas comment je suis sorti de là...",
              "une sorte d'intervention venue de loin...",
              "D'abord, il faut que je retrouve les autres."
            ],
            "it": [
              "Non capisco ancora come sono riuscito a uscire da lì...",
              "qualche intervento da lontano...",
              "Innanzitutto devo trovare gli altri."
            ],
            "ja": [
              "一体どうやって あそこから出られたんだ？",
              "遠くから誰かが 助けてくれたのか？",
              "まずは他の皆を探さねば。"
            ],
            "ko": [
              "내가 거길 어떻게 빠져나왔는지 아직도 이해가 안 되네...",
              "먼 곳에서의 개입 같은 거겠지...",
              "일단은 다른 애들을 찾아야지."
            ],
            "pt-br": [
              "Ainda não entendi como saí de lá...",
              "algum tipo de intervenção à distância...",
              "Primeiro, vou encontrar os outros."
            ],
            "ru": [
              "До сих пор не понимаю, как выбрался оттуда...",
              "наверное, кто-то вмешался издалека...",
              "Сначала найду остальных."
            ],
            "s-cn": [
              "到现在还没想明白我是怎么出来的……",
              "像是有某种力量从远处插手了……",
              "先去找其他人。"
            ],
            "t-cn": [
              "到現在還沒想明白我是怎麼出來的……",
