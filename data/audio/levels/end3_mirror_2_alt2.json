          "transcripts": {
            "en": [
              "I wonder how she'll react when she finds out I'm not dead."
            ],
            "de": [
              "Ich frage mich, wie sie reagiert, wenn sie erfährt, dass ich noch lebe."
            ],
            "es": [
              "Me pregunto cómo reaccionará cuando se entere de que no estoy muerto."
            ],
            "fr": [
              "Je me demande comment elle réagira quand elle apprendra que je ne suis pas mort."
            ],
            "it": [
              "Mi chiedo come reagirà quando scoprirà che non sono morto."
            ],
            "ja": [
              "私が死んでいないと知ったら、 彼女はどんな顔をするだろう。"
            ],
            "ko": [
              "내가 죽지 않았다는 걸 알면 그녀가 어떻게 반응할지 궁금하네."
            ],
            "pt-br": [
              "Fico imaginando como ela vai reagir quando descobrir que eu não morri."
            ],
            "ru": [
              "Интересно, как она отреагирует когда узнает, что я не мёртв."
            ],
            "s-cn": [
              "不知道她发现我没死，会有什么反应。"
            ],
            "t-cn": [
              "不知道她發現我沒死，會有什麼反應。"
            ]
