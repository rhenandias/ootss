          "transcripts": {
            "en": [
              "I wonder how the goblins feel about all this weird water."
            ],
            "de": [
              "Ich frage mich, was die Goblins von all diesem seltsamen Wasser halten."
            ],
            "es": [
              "Me pregunto qué pensarán los goblins de toda esta agua tan rara."
            ],
            "fr": [
              "Je me demande ce que les gobelins pensent de toute cette eau bizarre."
            ],
            "it": [
              "Mi domando cosa pensano i goblin di quest'acqua così strana."
            ],
            "ja": [
              "この変な水、 ゴブリンはどう思ってんだろうな。"
            ],
            "ko": [
              "고블린들은 이 이상한 물을 어떻게 생각할지 궁금하군."
            ],
            "pt-br": [
              "Fico pensando o que os goblins acham de toda essa água esquisita."
            ],
            "ru": [
              "Интересно, как гоблины относятся ко всей этой странной воде."
            ],
            "s-cn": [
              "不知道哥布林会怎么看这些古怪的水。"
            ],
            "t-cn": [
              "不知道哥布林會怎麼看這些古怪的水。"
            ]
